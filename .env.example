SQL_CONNECTION_STRING=Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=task_tracker;User ID=YOUR-USER;Password=YOUR-PASSWORD;Encrypt=true;
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.robotics13115.task_tracker
PORT=8080
# Signs session tokens. Long random string, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
# Temporarily serve app builds that predate session tokens (they send no
# token). Reopens the old hole while on - set back to false once everyone
# has the new build.
ALLOW_LEGACY_CLIENTS=false
